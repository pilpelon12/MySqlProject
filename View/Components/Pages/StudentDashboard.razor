@page "/student-dashboard"
@inject View.Services.UserSession Session
@inject NavigationManager Navigation

<PageTitle>אזור תלמידים | מגמת מחשבים</PageTitle>

@if (Session.IsLoggedIn && Session.RoleName == "Student")
{
    <div class="container py-5">
        <h1 class="h3 text-light mb-1">שלום @Session.Username,</h1>
        <p class="text-secondary mb-4">כאן תוכל לעקוב אחר ההתקדמות שלך ולהגיש תרגילים.</p>

        <!-- שימוש ברכיב המשותף -->
        <div class="row g-4 mb-4">
            <div class="col-12 col-md-4">
                <DashboardCard Title="ממוצע ציונים" Value="92" Icon="emoji_events" ColorClass="success" />
            </div>
            <div class="col-12 col-md-4">
                <DashboardCard Title="תרגילים שהוגשו" Value="15" Icon="task_alt" ColorClass="info" />
            </div>
            <div class="col-12 col-md-4">
                <DashboardCard Title="משימות פתוחות" Value="2" Icon="assignment_late" ColorClass="warning" />
            </div>
        </div>

        <!-- דוגמה למשימות פתוחות -->
        <div class="card card-portal p-4 mt-2">
            <h5 class="text-light mb-3">משימות פתוחות להגשה</h5>
            <div class="d-flex align-items-center justify-content-between border-bottom border-secondary border-opacity-10 pb-3 mb-3">
                <div>
                    <h6 class="text-info mb-1">פרויקט מחצית - OOP</h6>
                    <small class="text-secondary">הגשה עד: 30.11.2026</small>
                </div>
                <button class="btn btn-sm btn-primary">הגש פתרון</button>
            </div>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-info mb-1">תרגול רקורסיה מתקדם</h6>
                    <small class="text-secondary">הגשה עד: 05.12.2026</small>
                </div>
                <button class="btn btn-sm btn-outline-primary">המשך עבודה</button>
            </div>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        if (!Session.IsLoggedIn) Navigation.NavigateTo("/login");
        else if (Session.RoleName != "Student") Navigation.NavigateTo("/access-denied");
    }
}