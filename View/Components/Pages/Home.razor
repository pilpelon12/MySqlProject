@page "/"

<PageTitle>מגמת מדעי המחשב - פורטל הלמידה</PageTitle>

<!-- אזור פתיחה (Hero) -->
<section class="py-5 text-center">
    <div class="container py-4">
        <h1 class="display-4 fw-bold text-primary mb-3">מגמת מדעי המחשב</h1>
        <p class="lead text-secondary mb-4 mx-auto" style="max-width: 600px;">
            פלטפורמת למידה, ניהול משימות והגשות אינטראקטיביות לתלמידי ומורי המגמה.
            שליטה ב-C#, אלגוריתמיקה ופיתוח פרויקטים.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a href="/register" class="btn btn-primary btn-lg px-4">הרשמה למערכת</a>
            <a href="/login" class="btn btn-outline-primary btn-lg px-4">כניסה</a>
        </div>
    </div>
</section>

<!-- אזור נושאי הלימוד -->
<section class="py-5">
    <div class="container">
        <h2 class="text-center fw-bold mb-5">מה לומדים במגמה?</h2>
        <div class="row g-4 text-center">

            <div class="col-md-4">
                <div class="card shadow-sm h-100 p-4 border-0 rounded-4 bg-light">
                    <h3 class="h5 fw-bold text-primary mb-3">תכנות מונחה עצמים (OOP)</h3>
                    <p class="text-secondary mb-0">
                        מחלקות, עצמים, הורשה ופולימורפיזם בשפת C#. בניית קוד נקי ומודולרי.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm h-100 p-4 border-0 rounded-4 bg-light">
                    <h3 class="h5 fw-bold text-primary mb-3">אלגוריתמיקה ומבני נתונים</h3>
                    <p class="text-secondary mb-0">
                        סיבוכיות, רקורסיה, עצי חיפוש, מחסניות ותורים. פיתוח חשיבה לוגית מתקדמת.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm h-100 p-4 border-0 rounded-4 bg-light">
                    <h3 class="h5 fw-bold text-primary mb-3">פיתוח מערכות ו-MySQL</h3>
                    <p class="text-secondary mb-0">
                        בניית פרויקט גמר מלא: מסדי נתונים, שרתי API וממשק משתמש ב-Blazor.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- אזור סביבת המעבדה -->
<section class="py-5">
    <div class="container">
        <h2 class="text-center fw-bold mb-5">סביבת התרגול והמעבדה</h2>
        <div class="row justify-content-center g-4">

            <div class="col-md-8 col-lg-6">
                <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                    <img src="@Assets["images/classroom.jpg"]" alt="מעבדת מדעי המחשב" class="w-100 h-auto rounded-4" />
                    <div class="card-body text-center p-4">
                        <h4 class="h5 fw-bold text-primary mb-2">עמדות פיתוח משולבות</h4>
                        <p class="text-secondary mb-4">
                            עבודה מקצועית ב-Visual Studio, דיבאגינג מתקדם ופתרון בעיות מעשיות בזמן אמת.
                        </p>
                        <a href="/register" class="btn btn-primary px-4">הצטרפות למעבדה</a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>