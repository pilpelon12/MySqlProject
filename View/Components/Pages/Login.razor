@page "/login"
@using System.Net
@using Model
@inject HttpClient Http
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>כניסה למגמת מדעי המחשב</PageTitle>

<div class="container py-5 my-auto">
    <div class="row justify-content-center">
        <div class="col-12 col-md-7 col-lg-5">
            <!-- כותרת עליונה בסגנון טרמינל -->
            <div class="d-flex align-items-center justify-content-between mb-3 px-1">
                <div class="d-flex align-items-center gap-1 text-secondary">
                    <span class="material-symbols-outlined" style="font-size: 16px;">terminal</span>
                    <span class="font-code small text-uppercase">CS.ACADEMY // LOGIN_PORTAL</span>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <span class="badge rounded-pill bg-info bg-opacity-25 text-info small">גרסה 6</span>
                </div>
            </div>

            <!-- כרטיס הכניסה הראשי -->
            <div class="card card-portal p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="icon-box mx-auto mb-3 bg-secondary bg-opacity-15 text-secondary">
                        <span class="material-symbols-outlined">login</span>
                    </div>
                    <h1 class="h3 fw-bold text-light mb-1">כניסה למערכת המגמה</h1>
                    <p class="text-secondary opacity-75 small">
                        התחברו לצפייה במשימות, תרגול והגשת פתרונות
                    </p>
                </div>

                @if (errorMessage != null)
                {
                    <div class="alert alert-danger mb-3 small" role="alert">@errorMessage</div>
                }

                <form>
                    <!-- שדה 1: שם משתמש או אימייל -->
                    <Field Id="login-username"
                           Label="שם משתמש או אימייל"
                           Placeholder="למשל: student_noam או אימייל"
                           Icon="person"
                           Required="true"
                           @bind-Value="username" />

                    <!-- שדה 2: סיסמה (משמאל לימין) -->
                    <Field Id="login-password"
                           Label="סיסמה"
                           Type="password"
                           Dir="ltr"
                           Placeholder="••••••••"
                           Icon="lock"
                           Required="true"
                           @bind-Value="password" />

                    <!-- זכור אותי וקישור שכחתי סיסמה -->
                    <div class="d-flex justify-content-between align-items-center mb-3 small">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="rememberMe">
                            <label class="form-check-label text-secondary opacity-75" for="rememberMe">
                                זכור אותי במחשב זה
                            </label>
                        </div>
                        <a href="javascript:void(0)" class="text-secondary text-decoration-none opacity-75">
                            שכחת סיסמה?
                        </a>
                    </div>

                    <!-- כפתור כניסה -->
                    <button type="button" class="btn btn-primary btn-lg w-100 mt-2 py-2 fw-semibold" disabled="@isBusy" @onclick="LoginAsync">
                        <span class="align-middle">@(isBusy ? "מתחבר..." : "התחברות למערכת")</span>
                        <span class="material-symbols-outlined align-middle ms-1" style="font-size: 19px;">login</span>
                    </button>
                </form>

                <!-- קישור להרשמה מתחת לטופס -->
                <div class="text-center mt-4 pt-2 border-top border-secondary border-opacity-10">
                    <span class="text-secondary opacity-75 small">עדיין אין לך חשבון?</span>
                    <a href="/register" class="text-info fw-semibold text-decoration-none ms-1 small">
                        הרשמה למגמה
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string? username;
    private string? password;
    private string? errorMessage;
    private bool isBusy = false;

    private async Task LoginAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "יש למלא שם משתמש וסיסמה.";
            return;
        }

        isBusy = true;

        try
        {
            // שולחים לבקר את השם והסיסמה
            User credentials = new User { Username = username.Trim(), Password = password };
            HttpResponseMessage response = await Http.PostAsJsonAsync("api/users/login", credentials);

            // קוד 401: השם או הסיסמה שגויים
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                errorMessage = "שם המשתמש או הסיסמה שגויים.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "הכניסה נכשלה. נסו שוב.";
                return;
            }

            // הבקר החזיר את המשתמש עם התפקיד שלו
            User? user = await response.Content.ReadFromJsonAsync<User>();
            if (user == null)
            {
                errorMessage = "הכניסה נכשלה. נסו שוב.";
                return;
            }

            // שומרים בשירות. מכאן כל הדפים יודעים מי מחובר
            // שומרים בשירות. מכאן כל הדפים יודעים מי מחובר
            Session.Login(user);

            // שלב 8: ניתוב לפי התפקיד של המשתמש שהתחבר
            if (user.RoleName == "Admin")
            {
                Navigation.NavigateTo("/admin-dashboard");
            }
            else if (user.RoleName == "Teacher")
            {
                Navigation.NavigateTo("/teacher-dashboard");
            }
            else if (user.RoleName == "Student")
            {
                Navigation.NavigateTo("/student-dashboard");
            }
            else
            {
                // אם התפקיד לא מוכר, מעבירים לדף הראשי
                Navigation.NavigateTo("");
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "השרת לא זמין כרגע. נסו שוב בעוד רגע.";
        }
        finally
        {
            isBusy = false;
        }
    }
}
    }
}