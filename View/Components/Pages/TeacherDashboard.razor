@page "/teacher-dashboard"
@inject View.Services.UserSession Session
@inject NavigationManager Navigation

<PageTitle>אזור מורים | מגמת מחשבים</PageTitle>

@if (Session.IsLoggedIn && Session.RoleName == "Teacher")
{
    <div class="container py-5">
        <h1 class="h3 text-light mb-1">ברוך הבא, סגל ההוראה</h1>
        <p class="text-secondary mb-4">ניהול כיתות, בדיקת עבודות ומעקב תלמידים.</p>

        <!-- שימוש ברכיב המשותף לכרטיסיות -->
        <div class="row g-4 mb-5">
            <div class="col-12 col-md-6 col-lg-3">
                <DashboardCard Title="הגשות להיום" Value="12" Icon="inbox" ColorClass="warning" />
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <DashboardCard Title="הגשות שנבדקו" Value="45" Icon="grading" ColorClass="success" />
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <DashboardCard Title="ממוצע ציונים" Value="87.5" Icon="timeline" ColorClass="info" />
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <DashboardCard Title="הודעות תלמידים" Value="3" Icon="forum" ColorClass="primary" />
            </div>
        </div>

        <h4 class="text-light mb-3">הגשות אחרונות לבדיקה (הדגמה)</h4>
        <div class="table-responsive">
            <table class="table table-portal table-borderless">
                <thead>
                    <tr>
                        <th>תלמיד</th>
                        <th>תרגיל</th>
                        <th>תאריך הגשה</th>
                        <th>פעולות</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>נועם כהן</td>
                        <td>לולאות מורכבות ב-C#</td>
                        <td>היום, 14:30</td>
                        <td><button class="btn btn-sm btn-outline-info">בדוק הגשה</button></td>
                    </tr>
                    <tr>
                        <td>מאיה לוי</td>
                        <td>מערכים דו מימדיים</td>
                        <td>אתמול, 18:15</td>
                        <td><button class="btn btn-sm btn-outline-info">בדוק הגשה</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        if (!Session.IsLoggedIn) Navigation.NavigateTo("/login");
        else if (Session.RoleName != "Teacher") Navigation.NavigateTo("/access-denied");
    }
}